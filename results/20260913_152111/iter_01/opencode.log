static void conv2( void *ctxt, const int8_t* input, const int8_t* weights, const int32_t* bias, int8_t* output, const float* acc_scale ) {
for (int_fast32_t oh = 0; oh < 7; oh++) {
  for (int_fast32_t ow = 0; ow < 7; ow++) {
    for (int_fast32_t oc = 0; oc < 32; oc++) {
      int32_t sum;
      sum = bias[oc];
      for (int_fast32_t kh = 0; kh < 3; kh++) {
        for (int_fast32_t kw = 0; kw < 3; kw++) {
          for (int_fast32_t ic = 0; ic < 64; ic++) {
            int32_t x;
            int32_t w;
            x = (int32_t)(input[(oh + kh) * 576 + (ow + kw) * 64 + ic]);
            w = (int32_t)(weights[oc * 576 + kh * 192 + kw * 64 + ic]);
            sum += x * w;
          }
        }
      }
      float val;
      val = (float)(sum);
      val = val * *acc_scale;
      val = val + _select_float((float)val, (float)0.0f, (float)-0.5f, (float)0.5f);
      val = fmaxf((float)(-128.0f), (float)(_select_float((float)val, (float)127.0f, (float)val, (float)127.0f)));
      output[oh * 224 + ow * 32 + oc] = (int8_t)(val);
    }
  }
}
}

