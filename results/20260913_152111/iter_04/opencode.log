def matmul_transA(A: i8[32, 9, 9] @ DRAM, B: i8[32, 9, 9] @ DRAM,
                  C: i8[9, 9, 9, 9] @ DRAM, acc_scale: f32 @ DRAM):
    At_all: i8[9, 9, 32] @ DRAM
    for i1 in seq(0, 9):
        for i2 in seq(0, 9):
            for i0o in seq(0, 4):
                At_all[i1, i2, 8 * i0o] = A[8 * i0o, i1, i2]
                At_all[i1, i2, 1 + 8 * i0o] = A[1 + 8 * i0o, i1, i2]
                At_all[i1, i2, 2 + 8 * i0o] = A[2 + 8 * i0o, i1, i2]
                At_all[i1, i2, 3 + 8 * i0o] = A[3 + 8 * i0o, i1, i2]
