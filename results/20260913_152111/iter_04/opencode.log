                At_all[i1, i2, 6 + 8 * i0o] = A[6 + 8 * i0o, i1, i2]
                At_all[i1, i2, 7 + 8 * i0o] = A[7 + 8 * i0o, i1, i2]
    for i1 in seq(0, 9):
        for i2 in seq(0, 9):
            for j1 in seq(0, 9):
                for j2 in seq(0, 9):
                    sum: i32 @ DRAM
                    sum = 0.0
                    for k in seq(0, 32):
