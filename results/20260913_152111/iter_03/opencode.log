def _make_leaky_relu_requant(d0, d1, d2):
    @proc
    def leaky_relu_requant(values: i8[d0, d1, d2] @ DRAM, scale: f32 @ DRAM):
        for i in seq(0, d0):
            for j in seq(0, d1):
                for k in seq(0, d2):
                    x: f32
                    val: f32
                    x = values[i, j, k]
                    val = relu(x) * scale
                    val = val + select(val, 0.0, -0.5, 0.5)
                    val = fmaxf(-128.0, select(val, 127.0, val, 127.0))
                    values[i, j, k] = val

    return leaky_relu_requant


