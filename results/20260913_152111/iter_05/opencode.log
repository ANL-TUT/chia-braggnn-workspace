def st_acc_i8(n: size, m: size, scale: f32 @ DRAM, act: bool @ DRAM,
              src: [i32][n, 16] @ GEMM_ACCUM, dst: [i8][n, m] @ DRAM):
    # @instr gemmini_extended_config_st({dst}.strides[0]*1, {act}, {scale}[0]);
    #        gemmini_extended_mvout( ((uint64_t) &{dst_data}), (uint32_t) &{src_data}, {m}, {n} );
    assert n <= 16
    assert m <= 16
    assert stride(dst, 1) == 1
    assert stride(src, 0) == 16
    assert stride(src, 1) == 1
    for i in seq(0, n):
        for j in seq(0, m):
            src_tmp: i32 @ DRAM
            src_tmp = src[i, j]
            tmp: f32 @ DRAM
            acc_scale(src_tmp, tmp, scale)
            tmp2: i8 @ DRAM
            clamp(tmp, tmp2)
            if act == True:
                tmp2 = relu(tmp2)
            dst[i, j] = tmp2


