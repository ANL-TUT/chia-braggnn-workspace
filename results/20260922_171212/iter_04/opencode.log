def fc3(inp: i8[8, 1, 1] @ DRAM, weights: i8[4, 8, 1, 1] @ DRAM,
        bias: i32[4] @ DRAM, output: i8[4, 1, 1] @ DRAM, scale: f32 @ DRAM,
        post_scale: f32 @ DRAM):
    for j in seq(0, 4):
        res: i32 @ DRAM
        res = bias[j]
        for kch in seq(0, 8):
            for krow in seq(0, 1):
                for kcol in seq(0, 1):
                    w_s: i8 @ DRAM
                    w_s = weights[j, kch, krow, kcol]
                    i_s: i8 @ DRAM
                    i_s = inp[kch, krow, kcol]
                    a2: i32 @ DRAM
                    b2: i32 @ DRAM
                    a2 = i_s
                    b2 = w_s
                    res += a2 * b2
        tmp_scale: f32 @ DRAM
        tmp_scale = scale * post_scale
        src_tmp: i32 @ DRAM
        src_tmp = res
        tmp_res1: f32 @ DRAM
        acc_scale(src_tmp, tmp_res1, tmp_scale)
        tmp_res2: i8 @ DRAM
        clamp(tmp_res1, tmp_res2)
        tmp_res2 = relu(tmp_res2)
        output[j, 0, 0] = tmp_res2


