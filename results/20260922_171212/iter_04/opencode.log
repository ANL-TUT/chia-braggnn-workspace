def clamp(src: f32 @ DRAM, dst: i8 @ DRAM):
    l: f32 @ DRAM
    h: f32 @ DRAM
    l = -128.0
    h = 127.0
    tmp: f32 @ DRAM
    tmp = select(h, src, h, src)
    tmp = select(src, l, l, tmp)
    dst = tmp


